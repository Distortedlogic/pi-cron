{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"include": [".forgejo/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
