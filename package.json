{
	"name": "pi-cron",
	"version": "0.1.2",
	"private": true,
	"description": "Run scheduled Pi prompt chains from AGENTS.yml.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-cron.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"format": "biome check --write .",
		"lint": "biome check .",
		"test": "npm run test:e2e",
		"test:e2e": "node --import tsx --test test/e2e.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"agents.ts",
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"croner": "10.0.1",
		"pi-agents-yaml": "github:Distortedlogic/pi-agents-yaml#761369f8e34b460ed20deff4d733ef3963fef892"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.87.0",
		"@earendil-works/pi-coding-agent": "0.87.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-ai": "0.87.0",
		"@earendil-works/pi-coding-agent": "0.87.0",
		"@types/node": "22.20.3",
		"minimatch": "10.2.6",
		"tsx": "4.23.15",
		"typebox": "1.3.34",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	}
}
